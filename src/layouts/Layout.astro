---
// El bloque entre --- se llama "frontmatter". Es TypeScript/JS que corre en el servidor.
// Aquí defines variables, importas cosas, etc. El navegador NUNCA ve este código.
interface Props {
  title?: string;
}
const { title = 'Miguel del Angel Queb Silva' } = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- Fuentes de Google -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@300;400;500;600&display=swap" rel="stylesheet" />

    <!-- Este script corre ANTES de renderizar la página, evita el flash de tema incorrecto -->
    <script is:inline>
      const saved = localStorage.getItem('theme') || 'dark';
      document.documentElement.dataset.theme = saved;
    </script>
  </head>
  <body>
    <!-- slot = el hueco donde va el contenido de cada página -->
    <slot />

    <!-- Script de scroll reveal: observa elementos y les agrega la clase "on" al entrar en pantalla -->
    <script>
      const obs = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) { e.target.classList.add('on'); obs.unobserve(e.target); }
        });
      }, { threshold: 0.05, rootMargin: '0px 0px -24px 0px' });

      document.querySelectorAll('.r-up,.r-left,.r-right,.r-scale').forEach(el => obs.observe(el));
    </script>
  </body>
</html>

<!-- "is:global" hace que este CSS aplique a TODA la página, no solo a este componente -->
<style is:global>
  /* ── Variables de color y tipografía ── */
  :root {
    --bg:       #0B0E1C;
    --bg-2:     #10142A;
    --bg-3:     #161A30;
    --surface:  #1E2240;
    --border:   rgba(255,255,255,.07);
    --border2:  rgba(255,255,255,.14);
    --ink:      #E8EAFA;
    --ink-2:    #9094BA;
    --ink-3:    #52567A;
    --green:    oklch(0.74 0.22 278);
    --violet:   oklch(0.68 0.20 295);
    --green-d:  oklch(0.74 0.22 278 / .13);
    --violet-d: oklch(0.68 0.20 295 / .13);
    --grad-ink: linear-gradient(135deg, #ffffff 0%, oklch(0.82 0.10 278) 100%);
    --font-d:   'Outfit', sans-serif;
    --font-b:   'Space Grotesk', sans-serif;
    --ease:     cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Modo claro: sobreescribe las mismas variables */
  [data-theme="light"] {
    --bg:       #E8E6F0;
    --bg-2:     #DEDCEA;
    --bg-3:     #D2D0E0;
    --surface:  #C4C2D6;
    --border:   rgba(20,15,50,.12);
    --border2:  rgba(20,15,50,.22);
    --ink:      #14122B;
    --ink-2:    #3F3C66;
    --ink-3:    #6E6B92;
    --green:    oklch(0.52 0.22 285);
    --violet:   oklch(0.48 0.24 295);
    --green-d:  oklch(0.52 0.22 285 / .14);
    --violet-d: oklch(0.48 0.24 295 / .14);
    --grad-ink: linear-gradient(135deg, oklch(0.35 0.10 285) 0%, oklch(0.50 0.20 295) 100%);
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-b);
    font-weight: 400;
    line-height: 1.7;
    overflow-x: hidden;
    cursor: none;
  }
  a { color: inherit; text-decoration: none; cursor: none; }
  ul { list-style: none; }
  nav, main, footer { position: relative; z-index: 2; }

  /* Grain sutil sobre toda la página */
  body::after {
    content: '';
    position: fixed; inset: 0;
    pointer-events: none; z-index: 9997; opacity: .022;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 200px;
  }

  /* Clases de animación: empiezan invisibles, se activan con la clase "on" */
  .r-up    { opacity:0; transform:translateY(30px);  transition:opacity .8s var(--ease),transform .8s var(--ease); }
  .r-left  { opacity:0; transform:translateX(-40px); transition:opacity .8s var(--ease),transform .8s var(--ease); }
  .r-right { opacity:0; transform:translateX(40px);  transition:opacity .8s var(--ease),transform .8s var(--ease); }
  .r-scale { opacity:0; transform:scale(.94);         transition:opacity .7s var(--ease),transform .7s var(--ease); }
  .r-up.on,.r-left.on,.r-right.on,.r-scale.on { opacity:1; transform:none; }
  .d1 { transition-delay:.07s; } .d2 { transition-delay:.14s; }
  .d3 { transition-delay:.21s; } .d4 { transition-delay:.28s; }
  .d5 { transition-delay:.35s; } .d6 { transition-delay:.42s; }

  /* Fondo con gradiente animado */
  .bg-mesh { position:fixed; inset:0; pointer-events:none; z-index:0; overflow:hidden; }
  .bg-mesh::before {
    content:''; position:absolute; width:700px; height:700px; border-radius:50%;
    background:radial-gradient(circle, oklch(0.68 0.20 295 / .18) 0%, transparent 65%);
    top:-200px; right:-200px;
    animation: meshA 18s ease-in-out infinite alternate;
  }
  .bg-mesh::after {
    content:''; position:absolute; width:500px; height:500px; border-radius:50%;
    background:radial-gradient(circle, oklch(0.74 0.22 278 / .10) 0%, transparent 65%);
    bottom:10%; left:-150px;
    animation: meshB 14s ease-in-out infinite alternate;
  }
  @keyframes meshA { from { transform:scale(1) translate(0,0); } to { transform:scale(1.2) translate(60px,80px); } }
  @keyframes meshB { from { transform:scale(1) translate(0,0); } to { transform:scale(1.3) translate(40px,-60px); } }

  /* Cursor personalizado */
  #cursor {
    position:fixed; width:10px; height:10px; border-radius:50%;
    background:var(--violet); pointer-events:none; z-index:9999;
    transform:translate(-50%,-50%);
    transition:width .3s var(--ease), height .3s var(--ease), opacity .3s;
    mix-blend-mode:screen;
  }
  [data-theme="light"] #cursor { mix-blend-mode:multiply; }
  #cursor-glow {
    position:fixed; width:280px; height:280px; border-radius:50%;
    background:radial-gradient(circle, oklch(0.74 0.22 278 / .09) 0%, transparent 65%);
    pointer-events:none; z-index:9998; transform:translate(-50%,-50%);
    transition:left .5s var(--ease), top .5s var(--ease);
  }

  /* Textos secundarios con degradado */
  .hero-bio, .tl-desc, .ach-detail, .p-desc, .life-val, .footer-copy {
    background: var(--grad-ink);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Layout general */
  .section-inner { max-width:1100px; margin-inline:auto; padding-inline:36px; }
  section { padding-block:88px; }
  section + section { border-top:1px solid var(--border); }
  .eyebrow {
    font-family:var(--font-d); font-size:.7rem; font-weight:700;
    letter-spacing:.18em; text-transform:uppercase; color:var(--ink-3);
    margin-bottom:48px; display:flex; align-items:center; gap:12px;
  }
  .eyebrow::before { content:''; display:block; width:32px; height:1px; background:var(--green); flex-shrink:0; }
  .eyebrow-count { margin-left:auto; font-size:.62rem; color:var(--ink-3); }

  /* Mobile */
  @media (max-width: 768px) {
    .section-inner { padding-inline:20px; }
    section { padding-block:60px; }
  }
</style>
