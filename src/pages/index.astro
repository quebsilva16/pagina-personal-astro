---
import Layout from '../layouts/Layout.astro';
import Cursor from '../components/Cursor.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import NowBar from '../components/NowBar.astro';
import Projects from '../components/Projects.astro';
import Gallery from '../components/Gallery.astro';
import Experience from '../components/Experience.astro';
import Achievements from '../components/Achievements.astro';
import Life from '../components/Life.astro';
import Blog from '../components/Blog.astro';
import GitHubRepositories from '../components/GitHubRepositories.astro';
import GitHubStats from '../components/GitHubStats.astro';
import GitHubWidget from '../components/GitHubWidget.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Miguel del Angel Queb Silva">
  <Cursor />
  <div class="bg-mesh" aria-hidden="true"></div>
  <Nav />
  <main>
    <Hero />
    <Marquee />
    <NowBar />
    <Projects />
    <GitHubStats />
    <Gallery />
    <GitHubRepositories />
    <Experience />
    <Achievements />
    <Life />
    <Blog />
  </main>
  <div class="section-inner" style="display: flex; justify-content: center; margin-block: 40px;">
    <GitHubWidget />
  </div>
  <Footer />
</Layout>
