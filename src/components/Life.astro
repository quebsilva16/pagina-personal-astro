---
const cards = [
  { label: 'Ciudad',       value: 'Campeche, México' },
  { label: 'Leyendo',      value: 'Thinking in Systems' },
  { label: 'Escuchando',   value: 'Indie mexicano + ambient' },
  { label: 'Último viaje', value: 'Oaxaca — mezcal y ruinas' },
  { label: 'Hobby',        value: "Fotografía análoga, Canonet '71" },
  { label: 'Fun fact',     value: 'Aprendí a programar para hacer un bot de Twitter' },
];
---
<section id="vida">
  <div class="section-inner">
    <p class="eyebrow r-up">Más allá del trabajo</p>
    <div class="life-grid">
      {cards.map((c, i) => (
        <div class={`life-card r-up d${i + 1}`}>
          <p class="life-lbl">{c.label}</p>
          <p class="life-val">{c.value}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .life-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .life-card { background: var(--bg-2); border: 1px solid var(--border); border-radius: 12px; padding: 18px 20px; transition: border-color .2s, transform .3s var(--ease); }
  .life-card:hover { border-color: var(--border2); transform: translateY(-2px); }
  .life-lbl { font-family: var(--font-d); font-size: .62rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 8px; }
  .life-val { font-size: .86rem; font-weight: 400; line-height: 1.45; background: var(--grad-ink); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  @media (max-width: 768px) { .life-grid { grid-template-columns: 1fr 1fr; } }
</style>
