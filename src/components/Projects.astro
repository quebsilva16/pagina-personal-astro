---
---
<section id="proyectos">
  <div class="section-inner">
    <p class="eyebrow r-up">Proyectos <span class="eyebrow-count">04</span></p>
    <div class="projects-grid">

      <div class="project-card tall r-left">
        <p class="p-num">01 — Featured</p>
        <h3 class="p-title">Notas al Margen</h3>
        <p class="p-desc">App minimalista para capturar ideas rápidas con soporte markdown, tags y búsqueda semántica. Sin cuenta, sin suscripción. Construida para durar.</p>
        <div class="p-tags">
          <span class="tag">React</span><span class="tag">SQLite</span>
          <span class="tag">Electron</span><span class="tag">TypeScript</span>
        </div>
        <div class="p-footer"><a href="#" class="p-arrow">Ver proyecto →</a></div>
      </div>

      <div class="project-card violet r-right d1">
        <p class="p-num">02</p>
        <h3 class="p-title">Mapa Sonoro</h3>
        <p class="p-desc">Visualización interactiva de géneros musicales de Latinoamérica.</p>
        <div class="p-tags"><span class="tag">D3.js</span><span class="tag">Web Audio</span></div>
        <div class="p-footer"><a href="#" class="p-arrow">Ver →</a></div>
      </div>

      <div class="project-card r-right d2">
        <p class="p-num">03</p>
        <h3 class="p-title">Tipografía Colonial</h3>
        <p class="p-desc">Fuentes inspiradas en inscripciones del sureste mexicano.</p>
        <div class="p-tags"><span class="tag">FontForge</span><span class="tag">SVG</span></div>
        <div class="p-footer"><a href="#" class="p-arrow">Ver →</a></div>
      </div>

    </div>
  </div>
</section>

<style>
  .projects-grid {
    display: grid; grid-template-columns: 5fr 4fr;
    grid-template-rows: auto auto; gap: 14px;
  }
  .project-card {
    background: var(--bg-2); border: 1px solid var(--border);
    border-radius: 14px; padding: 28px 30px;
    position: relative; overflow: hidden;
    transition: border-color .3s, transform .35s var(--ease);
  }
  .project-card::after {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(ellipse at 0% 100%, var(--violet-d), transparent 60%);
    opacity: 0; transition: opacity .4s;
  }
  .project-card:hover { border-color: oklch(0.72 0.20 285 / .4); transform: translateY(-3px); }
  .project-card:hover::after { opacity: 1; }
  .project-card.tall { grid-row: span 2; }
  .project-card.violet::after { background: radial-gradient(ellipse at 100% 0%, var(--violet-d), transparent 60%); }
  .project-card.violet:hover { border-color: oklch(0.72 0.20 285 / .4); }
  .p-num { font-family: var(--font-d); font-size: .62rem; font-weight: 800; letter-spacing: .14em; color: var(--ink-3); margin-bottom: 20px; position: relative; z-index: 1; }
  .p-title { font-family: var(--font-d); font-size: 1.1rem; font-weight: 800; margin-bottom: 10px; position: relative; z-index: 1; transition: color .2s; line-height: 1.2; }
  .project-card:hover .p-title { color: var(--violet); }
  .project-card.violet:hover .p-title { color: var(--violet); }
  .p-desc { font-size: .82rem; line-height: 1.65; margin-bottom: 20px; position: relative; z-index: 1; }
  .p-tags { display: flex; flex-wrap: wrap; gap: 6px; position: relative; z-index: 1; }
  .tag { font-size: .65rem; font-weight: 700; letter-spacing: .06em; padding: 4px 9px; border-radius: 5px; background: var(--surface); color: var(--ink-3); border: 1px solid var(--border); }
  .p-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 20px; position: relative; z-index: 1; }
  .p-arrow { font-size: .73rem; font-weight: 700; color: var(--violet); letter-spacing: .04em; display: inline-flex; align-items: center; gap: 4px; transition: gap .2s; }
  .project-card.violet .p-arrow { color: var(--violet); }
  .project-card:hover .p-arrow { gap: 9px; }
  @media (max-width: 768px) {
    .projects-grid { grid-template-columns: 1fr; }
    .project-card.tall { grid-row: span 1; }
  }
</style>
