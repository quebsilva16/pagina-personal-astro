      </a>
    </div>
  </div>

  <div class="hero-right">
    <div class="hero-stat r-right d2">
      <p class="hero-stat-num">7<span>+</span></p>
      <p class="hero-stat-label">Años de experiencia</p>
    </div>
    <div class="hero-stat r-right d3">
      <p class="hero-stat-num">40<span>+</span></p>
      <p class="hero-stat-label">Proyectos completados</p>
    </div>
    <div class="hero-stat r-right d4">
      <p class="hero-stat-num">50<span>K</span></p>
      <p class="hero-stat-label">Lectores mensuales</p>
    </div>
  </div>
</section>

<script>
  function animateCount(el: HTMLElement, target: number, suffix: string) {
    let start = 0;
    const dur = 1400;
    const step = (ts: number) => {
      if (!start) start = ts;
      const p = Math.min((ts - start) / dur, 1);
      const ease = 1 - Math.pow(1 - p, 3);
      el.innerHTML = Math.round(ease * target) + '<span>' + suffix + '</span>';
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  const statObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        const nums = e.target.querySelectorAll<HTMLElement>('.hero-stat-num');
        const data: [number, string][] = [[7, '+'], [40, '+'], [50, 'K']];
        nums.forEach((n, i) => animateCount(n, data[i][0], data[i][1]));
        statObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.3 });

  const heroRight = document.querySelector('.hero-right');
  if (heroRight) statObs.observe(heroRight);
</script>

<style>
  #hero {
    min-height: 90vh; display: grid;
    grid-template-columns: 1fr 1fr; gap: 0;
    max-width: 1100px; margin-inline: auto;
    padding-inline: 36px; padding-block: 120px 80px;
    align-items: center;
  }
  .hero-left { padding-right: 40px; }
  .hero-right {
    display: flex; flex-direction: column; gap: 24px;
    border-left: 1px solid var(--border); padding-left: 48px;
  }
  .hero-status {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--green-d); border: 1px solid oklch(0.80 0.22 140 / .25);
    border-radius: 100px; padding: 5px 14px 5px 10px;
    font-size: .68rem; font-weight: 700; color: var(--green);
    letter-spacing: .1em; text-transform: uppercase; margin-bottom: 40px;
  }
  .sdot {
    width: 6px; height: 6px; border-radius: 50%; background: var(--green);
    animation: sdot 2s ease-in-out infinite;
  }
  @keyframes sdot {
    0%,100% { opacity:1; box-shadow:0 0 0 0 var(--green); }
    50%      { opacity:.5; box-shadow:0 0 0 6px transparent; }
  }
  .hero-name {
    font-family: var(--font-d); font-size: clamp(3.2rem, 6vw, 5rem);
    font-weight: 800; line-height: 1.0; letter-spacing: -.03em; margin-bottom: 24px;
  }
  .hero-name-outline {
    display: block; color: transparent;
    -webkit-text-stroke: 1.5px var(--ink-3); letter-spacing: -.03em;
  }
  .hero-role {
    font-size: .76rem; font-weight: 600; color: var(--green);
    letter-spacing: .12em; text-transform: uppercase; margin-bottom: 20px;
  }
  .hero-bio { font-size: .95rem; line-height: 1.8; margin-bottom: 36px; }
  .hero-links { display: flex; flex-wrap: wrap; gap: 10px; }
  .hl {
    display: inline-flex; align-items: center; gap: 7px;
    font-size: .76rem; font-weight: 600; padding: 9px 18px;
    border-radius: 8px; border: 1px solid var(--border2);
    color: var(--ink-2); transition: all .2s; letter-spacing: .04em;
  }
  .hl:hover { border-color: var(--green); color: var(--green); background: var(--green-d); }
  .hl.primary { background: var(--green); color: #060A05; border-color: transparent; }
  .hl.primary:hover { background: oklch(0.88 0.22 140); color: #060A05; }
  [data-theme="light"] .hl.primary { background: var(--violet); color: #fff; }
  .hero-stat { padding: 20px 0; border-bottom: 1px solid var(--border); }
  .hero-stat:first-child { padding-top: 0; }
  .hero-stat:last-child { border-bottom: none; padding-bottom: 0; }
  .hero-stat-num {
    font-family: var(--font-d); font-size: 2.4rem; font-weight: 800;
    letter-spacing: -.04em; line-height: 1; margin-bottom: 4px;
  }
  .hero-stat-num span { color: var(--green); }
  .hero-stat-label { font-size: .76rem; color: var(--ink-3); font-weight: 500; }
  @media (max-width: 768px) {
    #hero { grid-template-columns: 1fr; min-height: auto; padding-inline: 20px; }
    .hero-right { border-left: none; border-top: 1px solid var(--border); padding-left: 0; padding-top: 32px; flex-direction: row; flex-wrap: wrap; gap: 0; }
    .hero-stat { flex: 1 1 33%; padding: 16px; border-right: 1px solid var(--border); border-bottom: none; }
    .hero-stat:last-child { border-right: none; }
  }
</style>
