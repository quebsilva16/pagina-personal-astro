---
import { getRepositories } from '../lib/github';

const repositories = await getRepositories(6);
const GITHUB_USERNAME = import.meta.env.GITHUB_USERNAME || 'queb';
---

<section id="github-repos">
  <div class="section-inner">
    <p class="eyebrow r-up">Repositorios GitHub</p>

    {repositories.length > 0 ? (
      <div class="repos-grid">
        {repositories.map((repo, i) => (
          <a href={repo.url} target="_blank" rel="noopener" class={`repo-card r-up d${(i % 6) + 1}`}>
            <div class="repo-header">
              <h3 class="repo-name">{repo.name}</h3>
              <div class="repo-stars">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
                <span>{repo.stars}</span>
              </div>
            </div>

            {repo.description && (
              <p class="repo-description">{repo.description}</p>
            )}

            <div class="repo-footer">
              {repo.language && (
                <span class="repo-language">
                  <span class="lang-dot"></span>
                  {repo.language}
                </span>
              )}
              {repo.topics.length > 0 && (
                <div class="repo-topics">
                  {repo.topics.slice(0, 2).map(topic => (
                    <span class="topic">{topic}</span>
                  ))}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="repos-empty">No se pudieron cargar los repositorios. Intenta más tarde.</p>
    )}

    <div class="repos-cta r-up d4">
      <a href={`https://github.com/${GITHUB_USERNAME}`} target="_blank" rel="noopener" class="cta-link">
        Ver todos los repositorios →
      </a>
    </div>
  </div>
</section>

<style>
  #github-repos {
    padding-block: 88px;
  }

  .repos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-bottom: 40px;
  }

  .repo-card {
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px;
    transition: all .3s var(--ease);
    display: flex;
    flex-direction: column;
    gap: 16px;
    cursor: none;
  }

  .repo-card:hover {
    border-color: var(--violet);
    background: var(--bg-3);
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(104, 81, 192, 0.1);
  }

  .repo-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }

  .repo-name {
    font-family: var(--font-d);
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--ink);
    margin: 0;
    transition: color .2s;
  }

  .repo-card:hover .repo-name {
    color: var(--violet);
  }

  .repo-stars {
    display: flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-d);
    font-size: .85rem;
    font-weight: 700;
    color: var(--violet);
    white-space: nowrap;
  }

  .repo-stars svg {
    color: var(--violet);
  }

  .repo-description {
    font-size: .85rem;
    color: var(--ink-2);
    line-height: 1.6;
    margin: 0;
    flex: 1;
  }

  .repo-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 12px;
    border-top: 1px solid var(--border);
    font-size: .75rem;
  }

  .repo-language {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--ink-3);
    font-weight: 600;
  }

  .lang-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--violet);
  }

  .repo-topics {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .topic {
    display: inline-block;
    background: var(--violet-d);
    color: var(--violet);
    padding: 2px 8px;
    border-radius: 4px;
    font-weight: 600;
  }

  .repos-empty {
    text-align: center;
    color: var(--ink-3);
    padding: 40px 20px;
  }

  .repos-cta {
    text-align: center;
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-d);
    font-size: .76rem;
    font-weight: 800;
    color: var(--violet);
    letter-spacing: .06em;
    text-transform: uppercase;
    transition: gap .2s var(--ease);
  }

  .cta-link:hover {
    gap: 14px;
  }

  @media (max-width: 768px) {
    .repos-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

