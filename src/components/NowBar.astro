<div id="now">
  <div class="now-inner">
    <span class="now-label">Ahora mismo</span>
    <div style="display:flex;flex-wrap:wrap;gap:8px;">
      <span class="now-chip">⚙️ Construyendo <strong>&nbsp;SaaS de notas</strong></span>
      <span class="now-chip">📖 Leyendo <strong>&nbsp;Thinking in Systems</strong></span>
      <span class="now-chip">📍 <strong>Campeche, México</strong></span>
    </div>
  </div>
</div>

<style>
  #now { padding-block: 0; border-top: 1px solid var(--border); }
  .now-inner {
    max-width: 1100px; margin-inline: auto;
    padding-inline: 36px; padding-block: 20px;
    display: flex; flex-wrap: wrap; gap: 12px; align-items: center;
  }
  .now-label {
    font-family: var(--font-d); font-size: .65rem; font-weight: 800;
    letter-spacing: .16em; text-transform: uppercase; color: var(--green);
    flex-shrink: 0; margin-right: 8px;
  }
  .now-chip {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--bg-3); border: 1px solid var(--border2);
    border-radius: 8px; padding: 6px 14px;
    font-size: .76rem; color: var(--ink-2); transition: border-color .2s, color .2s;
  }
  .now-chip:hover { border-color: var(--green); color: var(--ink); }
  .now-chip strong { color: var(--ink); font-weight: 600; }
  @media (max-width: 768px) { .now-inner { padding-inline: 20px; } }
</style>
